# Copy to backend/.env and fill in. Never commit the real .env.

# ── Database (required) ─────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/motown
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/motown
# A local URI only works on the machine running MongoDB — deployed hosts need Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/motown

# ── CORS (required in production) ───────────────────────────────────────────
# Browser origin(s) allowed to call this API, comma-separated. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# ── Uploaded media (optional) ───────────────────────────────────────────────
# Defaults to backend/media. In production point at a persistent disk —
# a container's own filesystem is wiped on redeploy.
# MEDIA_DIR=/var/data/media

# ── Server (optional) ────────────────────────────────────────────────────────
# PORT=5000
