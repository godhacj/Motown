# Copy to backend/.env and fill in. Never commit the real .env.

MONGO_URI=
PORT=5000
MEDIA_DIR=

# Frontend origin allowed by CORS and socket.io
CLIENT_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Signs every login session (admins, teachers, students). Required in
# production; 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET=

# Set to 1 when running behind a proxy/load balancer (e.g. Render) so login
# rate limits see the real client IP.
TRUST_PROXY=
